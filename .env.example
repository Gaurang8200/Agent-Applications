# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Anthropic ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Database ---
POSTGRES_USER=agentapp
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=agent_applications
POSTGRES_HOST=localhost
# 5433, not 5432 — a native Postgres install commonly owns 5432 on the host and
# would shadow the container for localhost connections.
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://agentapp:change_me_locally@localhost:5433/agent_applications

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO locally, S3 in prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=resumes
S3_REGION=us-east-1

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# Where generated application PDFs are saved locally (one folder per company)
APPLICATIONS_DIR=~/AgentApplications

# --- Job sources ---
# Applicant tracking system boards, comma separated. These reach large
# employers that do not post to general job boards.
GREENHOUSE_BOARDS=celonis,n26,getyourguide,contentful
LEVER_HANDLES=wefox,flixbus
SMARTRECRUITERS_COMPANIES=BoschGroup

# Workday career sites as host:tenant:site triples, comma separated.
WORKDAY_SITES=nvidia.wd5:nvidia:NVIDIAExternalCareerSite

# --- Access control ---
# Comma-separated allowlist. Empty means open (fine locally); set one address
# before exposing the API publicly.
ALLOWED_EMAILS=

# --- Autonomous loop ---
AUTOPILOT_ENABLED=false
AUTOPILOT_INTERVAL_MINUTES=180
AUTOPILOT_SCORE_LIMIT=15
AUTOPILOT_PREPARE_LIMIT=3
AUTOPILOT_MIN_SCORE=60
